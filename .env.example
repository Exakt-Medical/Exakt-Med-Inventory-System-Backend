# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ExaktInventory
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT Configuration (Generate a Base64-encoded 256-bit secret, e.g. `openssl rand -base64 32`)
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION_MS=86400000

# OneRx 3rd-Party Integration API Key
ONERX_API_KEY=your_onerx_integration_api_key

# Initial SuperAdmin Bootstrap
SUPERADMIN_BOOTSTRAP_ENABLED=true
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_me_immediately

# RabbitMQ Facility & Project Sync
FACILITY_PROJECT_SYNC_MESSAGING_ENABLED=true
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=your_rabbitmq_username
SPRING_RABBITMQ_PASSWORD=your_rabbitmq_password
FACILITY_PROJECT_SYNC_EXCHANGE=facility-project.sync.exchange
FACILITY_SYNC_QUEUE=ipkras.facility.sync.queue
FACILITY_SYNC_ROUTING_KEY=facility.sync
PROJECT_SYNC_QUEUE=ipkras.project.sync.queue
PROJECT_SYNC_ROUTING_KEY=project.sync
