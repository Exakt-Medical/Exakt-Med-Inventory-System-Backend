# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ExaktInventory
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT Configuration (Generate a Base64-encoded 256-bit secret, e.g. `openssl rand -base64 32`)
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION_MS=86400000

# OneRx 3rd-Party Integration API Key
ONERX_API_KEY=your_onerx_integration_api_key

# Initial SuperAdmin Bootstrap
SUPERADMIN_BOOTSTRAP_ENABLED=true
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_me_immediately

# RabbitMQ Facility & Project Sync
FACILITY_PROJECT_SYNC_MESSAGING_ENABLED=true
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=your_rabbitmq_username
SPRING_RABBITMQ_PASSWORD=your_rabbitmq_password
SPRING_RABBITMQ_VIRTUAL_HOST=/
FACILITY_PROJECT_SYNC_EXCHANGE=facility-project.sync.exchange
FACILITY_SYNC_QUEUE=ipkras.facility.sync.queue
FACILITY_SYNC_ROUTING_KEY=facility.sync
PROJECT_SYNC_QUEUE=ipkras.project.sync.queue
PROJECT_SYNC_ROUTING_KEY=project.sync

# RabbitMQ OneRx Inventory Sync (Run script/Create OneRx Dispense Inbox.sql before enabling)
INVENTORY_SYNC_MESSAGING_ENABLED=false
INVENTORY_SYNC_EXCHANGE=inventory.sync.exchange
INVENTORY_DISPENSE_QUEUE=inventory.dispense.sync.queue
INVENTORY_DISPENSE_ROUTING_KEY=inventory.dispense.onerx
INVENTORY_STOCK_UPDATE_ROUTING_KEY=inventory.stock.update
INVENTORY_STOCK_SNAPSHOT_ROUTING_KEY=inventory.stock.snapshot
INVENTORY_STOCK_SNAPSHOT_BATCH_SIZE=200
INVENTORY_DISPENSE_ACK_ROUTING_KEY=inventory.dispense.ack
INVENTORY_SYNC_DLX=inventory.sync.dlx
INVENTORY_DISPENSE_DLQ=inventory.dispense.dlq
INVENTORY_DISPENSE_DLQ_ROUTING_KEY=inventory.dispense.dlq
